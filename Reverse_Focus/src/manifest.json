{
  "manifest_version": 3,
  "name": "Reverse Focus",
  "description": "Google extension to focus on the real tasks.",
  "version": "1.0",
  "action": {
    "default_popup": "index.html"
  },
  "host_permissions": [
    "https://zenquotes.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "webNavigation",
    "storage"
  ]
}
